{
  "manifest_version": 3,
  "name": "DOM Dump Picker",
  "description": "Dev tool: pick a DOM ancestor and POST outerHTML to a local receiver for agent workflows.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "DOM Dump Picker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
